# 复制本文件为 .env 后按需修改（.env 不进 git，因为里面有老板端密码）
# 选用哪一家店的配置。换店 = 改这一行 + 放一份新的 brands/<店>/ 文件夹。
BRAND=xiangcun
# 数据库文件位置（一个文件 = 一整本账）
DB_PATH=./data/app.db
# 本地备份目录。正式服务器定下来之后，改由 Litestream 实时复制到对象存储（见 deploy/litestream.yml）。
BACKUP_DIR=./backups
BACKUP_EVERY_MINUTES=10
# 老板上传的菜品图存放位置（备份时要一起备份）
UPLOAD_DIR=./data/uploads
# 后端端口（不用 PORT 这个名字：很多托管/预览工具会自行设置 PORT，导致前端代理指错地方）
API_PORT=8787
# 老板端登录密码（至少 8 位）。正式上线前由老板自己设置。
ADMIN_PASSWORD=

# ---------------- 打印机 ----------------
# 两台机器：receipt = 前台小票机，label = 吧台标签机
# 总开关：0 关（默认），1 开。先全关，等机器到了再逐个开、逐个验。
PRINT_RECEIPT_ON=0
# 连接方式：net（网口，需填 IP+端口）| usb（Linux /dev/usb/lp0）| system（走 lp 命令）| mock（演练，不出纸）
PRINT_RECEIPT_KIND=net
PRINT_RECEIPT_HOST=192.168.1.100
# 网口热敏机几乎都是 9100（RAW/JetDirect）
PRINT_RECEIPT_PORT=9100
# 纸宽：80 = 80mm（48 字/行），58 = 58mm（32 字/行）
PRINT_RECEIPT_PAPER=80
# 是否带切刀（1/0）
PRINT_RECEIPT_CUTTER=1
# 是否带钱箱（1/0，开了之后打小票会顺带弹钱箱）
PRINT_RECEIPT_DRAWER=0

PRINT_LABEL_ON=0
PRINT_LABEL_KIND=net
PRINT_LABEL_HOST=192.168.1.101
PRINT_LABEL_PORT=9100
# 标签机纸更窄，字号放大一级让杯贴远看清楚
PRINT_LABEL_BIGTABLE=1

# 汉字编码：国产热敏机（芯烨/佳博/中崎）基本都是 gbk，个别老机型 gb18030
PRINT_ENCODING=gbk
# 打不通时重试几次、每次间隔多久
PRINT_RETRIES=2
PRINT_BACKOFF_MS=1500
