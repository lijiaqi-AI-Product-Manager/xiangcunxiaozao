# 复制本文件为 .env 后按需修改（.env 不进 git，因为里面有老板端密码）
# 选用哪一家店的配置。换店 = 改这一行 + 放一份新的 brands/<店>/ 文件夹。
BRAND=xiangcun
# 数据库文件位置（一个文件 = 一整本账）
DB_PATH=./data/app.db
# 本地备份目录。正式服务器定下来之后，改由 Litestream 实时复制到对象存储（见 deploy/litestream.yml）。
BACKUP_DIR=./backups
BACKUP_EVERY_MINUTES=10
# 老板上传的菜品图存放位置（备份时要一起备份）
UPLOAD_DIR=./data/uploads
# 后端端口（不用 PORT 这个名字：很多托管/预览工具会自行设置 PORT，导致前端代理指错地方）
API_PORT=8787
# 1 = 同一个进程顺带把两个网页发出去：老板端 /admin/，顾客端 /。本机测试和正式部署都建议开。
SERVE_STATIC=1
# 老板端登录密码（至少 8 位）。正式上线前由老板自己设置。
ADMIN_PASSWORD=

# ---------------- 打印机 ----------------
# 店里两台机器（2026-10 到的货，铭牌参数）：
#   ZYWELL Zy307       80mm 热敏小票机  ESC/POS  USB + 网口   带切刀  230mm/s  钱箱口 12V
#   Xprinter XP-236B   58mm 纸/48mm 打印区  票据(ESC/POS)+标签(TSPL) 双模  USB + 蓝牙  无切刀
#
# 推荐接法：Zy307 当小票机（网口，最省事）；XP-236B 当标签机（USB 接店里那台电脑，或用
# USB 转网口打印服务器，两台都走网口）。
#
# **打印是从「跑后端的这台机器」发出去的，后端必须和打印机在同一个局域网。**
# 后端如果部署在云服务器（Zeabur / 阿里云 / 腾讯云），永远连不上店里的打印机——它面前只有公网。
# 所以：要么后端就装在店里的收银电脑上，要么店里再放一台机器跑后端（见 docs/打印机操作指南.md）。
#
# 总开关：0 关（默认），1 开。先全关，插好线先点「打测试页」，确认出纸了再开自动打印。
PRINT_RECEIPT_ON=0
# 连接方式：
#   net      网口（RAW/JetDirect 9100），填 HOST
#   winspool Windows 本机 USB：填 QUEUE = 控制面板里那台打印机的名字（不用共享，推荐）
#   usb      Linux: /dev/usb/lp0；Windows 只能填蓝牙串口 \\.\COM5（应急）
#   system   走系统打印队列：Linux 填 lp 队列名；Windows 填「打印机属性 → 共享」里的共享名
#   mock     演练模式，不出纸，只留记录
PRINT_RECEIPT_KIND=net
PRINT_RECEIPT_HOST=192.168.1.100
# 网口热敏机几乎都是 9100（RAW/JetDirect）
PRINT_RECEIPT_PORT=9100
# 纸宽：80 = 48 字/行，58 = 32 字/行（XP-236B 是 58mm 纸）
PRINT_RECEIPT_PAPER=80
# 有没有切刀（1/0）。Zy307 有；XP-236B 没有，设 0 会多走几行空白让人手撕
PRINT_RECEIPT_CUTTER=1
# 有没有接钱箱（1/0），开了之后打小票会顺带弹钱箱
PRINT_RECEIPT_DRAWER=0
# 汉字编码：gbk（国产机默认）| gb18030（GBK 超集，生僻字不丢）| utf8（少数外贸机）
# 留空则用下面的 PRINT_ENCODING 兜底
PRINT_RECEIPT_ENCODING=gbk

PRINT_LABEL_ON=0
PRINT_LABEL_KIND=usb
PRINT_LABEL_HOST=192.168.1.101
PRINT_LABEL_PORT=9100
# Windows 打印队列名（winspool 用，如 ZYWELL Zy307 / XP-236B）；共享打印也填这里
PRINT_LABEL_QUEUE=
PRINT_LABEL_DEVICE=
# 标签纸宽：58 = 32 字/行（XP-236B 的 48mm 打印区）| 80 = 48 字/行
# 只在 PRINT_LABEL_PROTOCOL=escpos 时生效；走 tspl 时按下面的毫米尺寸算，与这一行无关
PRINT_LABEL_PAPER=58
# 标签机有没有切刀（1/0）。XP-236B 没有，必须 0——误发切纸指令它会空吐一截纸
PRINT_LABEL_CUTTER=0
# 桌号用三倍字（1，远看清楚但费纸）还是两倍字（0，省纸）
PRINT_LABEL_BIGTABLE=1
PRINT_LABEL_ENCODING=gbk

# ---- 标签模式（模切标签纸）----
# 标签机指令集：escpos = 票据模式（连续纸收 ESC/POS）| tspl = 标签模式（间隙纸收 TSPL）
# 怎么判断：关机按住 FEED 再开机，自检页上写 Receipt 填 escpos，写 Label 填 tspl。
# 填错不会报错，只会打出一张空白或几行乱码——这是最容易白折腾半天的地方。
PRINT_LABEL_PROTOCOL=tspl
# 这卷标签的实际尺寸（毫米）。量底纸：宽 30、高 40、两片之间的缝 2
PRINT_LABEL_WIDTH_MM=30
PRINT_LABEL_HEIGHT_MM=40
PRINT_LABEL_GAP_MM=2
# 机器内置中文字库名。TSC 系是 TSS24.BF2；打出来一整张空白就换 TST24.BF2 再试
PRINT_LABEL_FONT=TSS24.BF2

# 两台没单独配编码时的兜底值
PRINT_ENCODING=gbk
# 打不通时重试几次、每次间隔多久（毫秒，指数退避）
PRINT_RETRIES=2
PRINT_BACKOFF_MS=1500
