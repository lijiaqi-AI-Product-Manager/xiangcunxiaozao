# ===== 湘村小灶 后端环境变量（复制到 Zeabur 面板填写）=====

# 服务端口（Zeabur 会自动注入 PORT，本地开发默认 3000）
PORT=3000

# 数据目录：容器内挂载持久卷的位置
DATA_DIR=/data

# 管理端令牌（老板后台登录用，至少16位随机串）
ADMIN_TOKEN=

# 后厨端令牌（后厨接单页登录用，至少16位随机串，与 ADMIN_TOKEN 不同）
KITCHEN_TOKEN=

# ===== 自动备份（可选：不配置则跳过备份）=====
# GitHub PAT（需要 contents 读写权限）
BACKUP_GITHUB_TOKEN=
# 备份目标私有仓库，格式 owner/repo
BACKUP_GITHUB_REPO=
# 保留最近多少份
BACKUP_KEEP=14
