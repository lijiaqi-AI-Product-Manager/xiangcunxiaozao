{
  "name": "restaurant-ordering",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "import:menu": "tsx --env-file=.env scripts/import-brand.ts",
    "check:brand": "tsx scripts/check-brand-literal.ts",
    "check:data": "tsx --env-file=.env scripts/validate-data.ts",
    "check:palette": "tsx --env-file=.env scripts/check-palette.ts",
    "check:audit": "npm audit --audit-level=moderate",
    "check": "npm run check:audit && npm run check:brand && npm run check:money && npm run check:palette && npm run check:data && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test:inventory": "tsx --env-file=.env scripts/test-inventory.ts",
    "reconcile:menu": "tsx --env-file=.env scripts/reconcile-menu.ts",
    "build:font": "tsx --env-file=.env scripts/build-fonts.ts",
    "compress:assets": "tsx --env-file=.env scripts/compress-assets.ts",
    "dev:server": "npm run dev -w @app/server",
    "dev:customer": "npm run dev -w @app/customer",
    "dev:admin": "npm run dev -w @app/admin",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "build:demo": "tsx --env-file=.env scripts/build-demo.ts",
    "check:money": "tsx scripts/check-money-format.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
